{
  "name": "edfund/foundation-cms",
  "description": "Purpose-specific EdFund CMS with secure visual page editing",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-dom": "*",
    "ext-sodium": "*"
  },
  "autoload": {
    "psr-4": {
      "EdFund\\": "app/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true,
    "allow-plugins": {}
  }
}
