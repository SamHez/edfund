# EdFund CMS document root: only public/ may be exposed by the web server.
DirectoryIndex index.php
Options -Indexes -MultiViews
<IfModule mod_rewrite.c>
RewriteEngine On
# Preserve provider-managed TLS validation files without routing them into the CMS.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^\.well-known/(?:acme-challenge|pki-validation)/[A-Za-z0-9_-]+(?:\.txt)?$ - [L]
# Bundled, trusted assets only; HTML pages, media and errors go through PHP.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^assets/.*\.(?:css|js|json|webp|png|jpe?g|svg|ico|ttf|woff2?)$ - [L,NC]
RewriteRule ^(?:favicon\.ico|favicon\.png)$ - [L]
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(css|js|webp|png|jpe?g|svg|ttf|woff2)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
