# EdFund Uganda Foundation — Apache static document root.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
# Verified equivalents: organisation, people, stories and contact information.
RewriteRule ^new-about-us/?$ /about-us/ [R=301,L]
RewriteRule ^(?:ourteam|meet-the-team)/?$ /our-team/ [R=301,L]
RewriteRule ^our-blog/?$ /stories-updates/ [R=301,L]
RewriteRule ^(?:new-contact-us|contact-us)/?$ /contact/ [R=301,L]
RewriteRule ^become-a-volunteer/?$ /volunteer/ [R=301,L]
# Only canonicalise the production hostname; local previews stay local.
RewriteCond %{HTTP_HOST} ^(?:www\.)?edfundfoundation\.org$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://edfundfoundation.org%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(css|js|webp|png|jpe?g|svg|ttf|woff2)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
